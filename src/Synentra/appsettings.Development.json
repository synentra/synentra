{
  "Kestrel": {
    "Endpoints": { "Http": { "Url": "http://localhost:7080" } },
    "Limits": {
      "MaxConcurrentConnections": 1000,
      "MaxConcurrentUpgradedConnections": 1000,
      "KeepAliveTimeout": "00:02:00",
      "RequestHeadersTimeout": "00:00:30",
      "MaxRequestBodySize": 52428800
    }
  },
  "Cors": {
    "AllowedOrigins": [ "https://localhost:7181" ],
    "AllowedMethods": [ "GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS" ],
    "AllowedHeaders": [ "Content-Type", "Authorization" ]
  },
  "OutboundHttp": {
    "AllowPrivateAddresses": true,
    "MaxResponseBodySizeBytes": 2097152,
    "Timeout": "00:00:30"
  },
  "DataProtection": {
    "ApplicationName": "synentra",
    "KeyRingPath": "./data/keys",
    "RequireEncryptedKeyRing": false,
    "DefaultKeyLifetime": "90.00:00:00",
    "Certificate": {
      "Path": ""
    }
  },
  "Persistence": {
    "Provider": "sqlite",
    "Providers": {
      "sqlite": { "ConnectionString": "Data Source=synentra.db" },
      "postgres": { "ConnectionString": "Host=localhost;Port=5432;Database=synentra;Username=postgres;Password=YOURPASSWORD" }
    }
  },
  "Logging": {
    "LogLevel": { "Default": "Information" },
    "File": {
      "Enabled": true,
      "LogPath": "logs/log-.txt",
      "RollingInterval": "Day",
      "RetainedFileCountLimit": 7,
      "MinimumLevel": "Warning"
    },
    "Seq": {
      "Enabled": false,
      "Url": "http://localhost:5341",
      "ApiKeySecretRef": null,
      "MinimumLevel": "Information"
    }
  },
  "OpenTelemetry": {
    "Enabled": false,
    "Endpoint": "http://localhost:4317",
    "ServiceName": "synentra",
    "ExportLogs": false,
    "ExportTraces": true,
    "ExportMetrics": true
  },
  "Identity": {
    "Provider": "oidc",
    "Claims": {
      "AgentId": "sub",
      "Roles": "roles",
      "SecurityScope": "security_scope"
    },
    "Providers": {
      "oidc": {
        "Authority": "http://localhost:8080/realms/synentra",
        "Audience": "synentra-agents",
        "Issuer": "http://localhost:8080/realms/synentra",
        "RequireHttpsMetadata": false
      },
      "ldap": {
        "Endpoint": "ldap://localhost:389",
        "BaseDn": "dc=example,dc=com",
        "UserDnPattern": "uid={0},ou=users,dc=example,dc=com",
        "BindDn": "cn=admin,dc=example,dc=com",
        "BindPasswordSecretRef": "<your-ldap-password-secret-ref>"
      }
    }
  },
  "Approvals": {
    "AllowSelfApproval": false,
    "AllowCrossScopeApproval": false
  },
  "Trust": {
    "InitialScore": 50,
    "QuarantineThreshold": 10,
    "MaxManualAdjustment": 10,
    "EvidenceWeights": {
      "SuccessfulExecution": 1,
      "ConfirmedMisuse": -25,
      "PolicyViolation": -5,
      "ReviewerAction": 0
    }
  },
  "Intent": {
    "Providers": {
      "Internal": {
        "Enabled": true,
        "ModelType": "Community",
        "PackagePath": "/models/community-model.zip"
      },
      "Ollama": {
        "Enabled": false,
        "Endpoint": "http://localhost:11434",
        "Model": "llama3.2"
      },
      "AzureAi": {
        "Enabled": false,
        "Endpoint": "https://<your-endpoint>.inference.ai.azure.com",
        "ApiKey": "<your-api-key>",
        "Model": "gpt-4o-mini"
      },
      "OpenAi": {
        "Enabled": false,
        "ApiKey": "<your-openai-api-key>",
        "Model": "gpt-4o-mini"
      },
      "Gemini": {
        "Enabled": false,
        "ApiKey": "<your-gemini-api-key>",
        "Model": "gemini-2.0-flash"
      }
    }
  },
  "Policy": {
    "Provider": "Declarative",
    "Providers": {
      "Opa": {
        "Url": "http://localhost:8181",
        "DecisionPath": "synentra/authz/decision",
        "Timeout": "00:00:05"
      }
    }
  },
  "BackgroundJobs": {
    "Outbox": {
      "Enabled": true,
      "PollingInterval": "00:00:02",
      "MaxAttempts": 5
    },
    "ClaimExpiration": {
      "Enabled": true,
      "PollingInterval": "00:00:30"
    }
  },
  "Initialization": {
    "ManifestBootstrap": {
      "Enabled": true
    }
  },
  "Secrets": {
    "Provider": "none",
    "Providers": {
      "LocalVault": {
        "Enabled": true
      }
    },
    "Resolution": {
      "Timeout": "00:00:30"
    },
    "Cache": {
      "Mode": "memory",
      "Ttl": "00:01:00",
      "MaximumEntries": 1024,
      "OutagePolicy": "use-unexpired-cache"
    }
  }
}