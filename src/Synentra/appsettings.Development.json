{
  "Kestrel": {
    "Endpoints": { "Http": { "Url": "http://localhost:7080" } },
    "Limits": {
      "MaxConcurrentConnections": 1000,
      "MaxConcurrentUpgradedConnections": 1000,
      "KeepAliveTimeout": "00:02:00",
      "RequestHeadersTimeout": "00:00:30",
      "MaxRequestBodySize": 52428800
    }
  },
  "Cors": {
    "AllowedOrigins": [ "https://localhost:7181" ],
    "AllowedMethods": [ "GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS" ],
    "AllowedHeaders": [ "Content-Type", "Authorization" ]
  },
  "OutboundHttp": {
    "AllowedDestinations": [
      "https://api.example.com",
      "https://internal.example.com",
      "https://inventory.internal.example",
      "http://localhost:8200",
      "http://localhost:8000"
    ],
    "AllowPrivateAddresses": true,
    "MaxResponseBodySizeBytes": 2097152,
    "Timeout": "00:00:30"
  },
  "DataProtection": {
    "ApplicationName": "synentra",
    "KeyRingPath": "./data/keys",
    "RequireEncryptedKeyRing": false,
    "DefaultKeyLifetime": "90.00:00:00",
    "Certificate": {
      "Path": ""
    }
  },
  "ResponseRetention": {
    "AuthenticatedResponsePolicies": {
      "inventory-api": {
        "Mode": "json-allowlist",
        "AllowedProperties": [
          "product_id",
          "name",
          "quantity"
        ]
      }
    }
  },
  "Persistence": {
    "Provider": "sqlite",
    "Providers": {
      "sqlite": { "ConnectionString": "Data Source=synentra.db" },
      "postgres": { "ConnectionString": "Host=localhost;Port=5432;Database=synentra;Username=postgres;Password=YOURPASSWORD" }
    }
  },
  "Logging": {
    "LogLevel": { "Default": "Information" },
    "File": {
      "Enabled": true,
      "LogPath": "logs/log-.txt",
      "RollingInterval": "Day",
      "RetainedFileCountLimit": 7,
      "MinimumLevel": "Warning"
    },
    "Seq": {
      "Enabled": false,
      "Url": "http://localhost:5341",
      "ApiKeySecretRef": null,
      "MinimumLevel": "Information"
    }
  },
  "OpenTelemetry": {
    "Enabled": false,
    "Endpoint": "http://localhost:4317",
    "ServiceName": "synentra",
    "ExportLogs": false,
    "ExportTraces": true,
    "ExportMetrics": true
  },
  "Identity": {
    "Provider": "oidc",
    "Providers": {
      "oidc": {
        "Authority": "http://localhost:8080/realms/synentra",
        "Audience": "synentra-agents",
        "Issuer": "http://localhost:8080/realms/synentra",
        "RequireHttpsMetadata": false,
        "SecurityScopeClaim": "security_scope",
        "AgentIdClaim": "sub",
        "RoleClaim": "roles"
      },
      "ldap": {
        "Host": "ldap://localhost",
        "Port": 389,
        "BaseDn": "dc=example,dc=com",
        "UserDnPattern": "uid={0},ou=users,dc=example,dc=com",
        "ServiceDn": "cn=admin,dc=example,dc=com",
        "ServicePassword": "<your-ldap-password>"
      }
    }
  },
  "Approvals": {
    "AllowSelfApproval": false,
    "AllowCrossScopeApproval": false,
    "MaxManualTrustAdjustment": 10
  },
  "Trust": {
    "InitialScore": 50,
    "QuarantineThreshold": 10,
    "EvidenceWeights": {
      "SuccessfulExecution": 1,
      "ConfirmedMisuse": -25,
      "PolicyViolation": -5,
      "ReviewerAction": 0
    }
  },
  "Semantic": {
    "Providers": {
      "Internal": {
        "ModelType": "Community",
        "PackagePath": "/models/community-model.zip"
      },
      "Ollama": {
        "Endpoint": "http://localhost:11434",
        "Model": "llama3.2"
      },
      "AzureAi": {
        "Endpoint": "https://<your-endpoint>.inference.ai.azure.com",
        "ApiKey": "<your-api-key>",
        "Model": "gpt-4o-mini"
      },
      "OpenAi": {
        "ApiKey": "<your-openai-api-key>",
        "Model": "gpt-4o-mini"
      },
      "Gemini": {
        "ApiKey": "<your-gemini-api-key>",
        "Model": "gemini-2.0-flash"
      }
    }
  },
  "Policy": {
    "Provider": "Declarative",
    "Providers": {
      "Opa": {
        "Url": "http://localhost:8181",
        "DecisionPath": "synentra/authz/decision",
        "Timeout": "00:00:05"
      }
    }
  },
  "BackgroundJobs": {
    "Outbox": {
      "Enabled": true,
      "PollingInterval": "00:00:02",
      "MaxAttempts": 5
    },
    "ClaimExpiration": {
      "Enabled": true,
      "PollingInterval": "00:00:30"
    },
    "Initialization": {
      "ManifestBootstrap": {
        "Enabled": true
      }
    }
  },
  "Secrets": {
    "Provider": "none",
    "Providers": {
      "LocalVault": {
        "Enabled": true
      }
    },
    "Resolution": {
      "Timeout": "00:00:30"
    },
    "Cache": {
      "Mode": "memory",
      "Ttl": "00:01:00",
      "MaximumEntries": 1024,
      "OutagePolicy": "use-unexpired-cache"
    }
  }
}